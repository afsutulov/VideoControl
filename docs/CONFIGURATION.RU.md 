    "level": "info",
    "file": "/var/log/videocontrol.log",
    "to_console": false
  },
  "storage": {
    "base_dir": "/share"
  },
  "motion": {
    "min_contour_area": 500,
    "threshold": 25
  },
  "recording": {
    "frame_width": 640,
    "frame_height": 360,
    "fps": 10,
    "codec": "mp4v",
    "post_recording": "5s",
    "reconnect_delay": "5s"
